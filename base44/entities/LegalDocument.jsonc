{
  "name": "LegalDocument",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "gdpr",
        "terms"
      ],
      "description": "Typ dokumentu: gdpr nebo terms"
    },
    "company": {
      "type": "string",
      "enum": [
        "Chrysos Media",
        "Anza Media"
      ],
      "default": "Chrysos Media",
      "description": "Firma, ke kter\u00e9 dokument pat\u0159\u00ed"
    },
    "title": {
      "type": "string",
      "description": "N\u00e1zev dokumentu"
    },
    "content": {
      "type": "string",
      "description": "Obsah dokumentu (plain text)"
    }
  },
  "required": [
    "key",
    "company",
    "title",
    "content"
  ]
}