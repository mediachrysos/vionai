{
  "name": "ChatterNote",
  "type": "object",
  "properties": {
    "chatter_email": {
      "type": "string",
      "description": "Email chattera"
    },
    "content": {
      "type": "string",
      "description": "Obsah pozn\u00e1mky"
    },
    "note_date": {
      "type": "string",
      "format": "date",
      "description": "Datum pozn\u00e1mky"
    },
    "customer_name": {
      "type": "string",
      "description": "Jm\u00e9no klienta"
    },
    "amount": {
      "type": "number",
      "description": "\u010c\u00e1stka"
    },
    "account": {
      "type": "string",
      "description": "ID bankovn\u00edho \u00fa\u010dtu"
    },
    "account_name": {
      "type": "string",
      "description": "N\u00e1zev \u00fa\u010dtu pro zobrazen\u00ed"
    },
    "model_id": {
      "type": "string",
      "description": "ID modelky"
    },
    "model_name": {
      "type": "string",
      "description": "Jm\u00e9no modelky pro zobrazen\u00ed"
    }
  },
  "required": [
    "chatter_email",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}