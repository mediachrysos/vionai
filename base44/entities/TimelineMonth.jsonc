{
  "name": "TimelineMonth",
  "type": "object",
  "properties": {
    "month_key": {
      "type": "string",
      "description": "Identifik\u00e1tor m\u011bs\u00edce, nap\u0159. 2026-04"
    },
    "label": {
      "type": "string",
      "description": "Zobrazovan\u00fd n\u00e1zev, nap\u0159. Duben 2026"
    },
    "order": {
      "type": "integer",
      "description": "Po\u0159ad\u00ed pro \u0159azen\u00ed"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "M\u011b\u0159iteln\u00e9 c\u00edle"
    },
    "doneTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Spln\u011bn\u00e9 c\u00edle (seznam text\u016f)"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Blokery / slabiny"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "done"
            ]
          },
          "deadline": {
            "type": "string"
          }
        }
      },
      "description": "\u00dakoly tohoto m\u011bs\u00edce"
    }
  },
  "required": [
    "month_key",
    "label",
    "order"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}