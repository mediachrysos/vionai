{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "chatter",
        "lawyer",
        "grafik"
      ],
      "default": "user",
      "description": "Role u\u017eivatele"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "blocked"
      ],
      "default": "pending",
      "description": "Stav \u00fa\u010dtu"
    },
    "assigned_model_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs p\u0159i\u0159azen\u00fdch modelek"
    },
    "allowed_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Povolen\u00e9 str\u00e1nky (pro custom opr\u00e1vn\u011bn\u00ed)"
    }
  },
  "required": [
    "assigned_model_ids",
    "allowed_pages"
  ]
}