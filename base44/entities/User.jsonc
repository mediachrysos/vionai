{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "chatter",
        "lawyer",
        "grafik"
      ],
      "default": "user",
      "description": "Prim\u00e1rn\u00ed role u\u017eivatele (legacy)"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "V\u0161echny role u\u017eivatele (m\u016f\u017ee m\u00edt v\u00edce)"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "blocked"
      ],
      "default": "pending",
      "description": "Stav \u00fa\u010dtu"
    },
    "assigned_model_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs p\u0159i\u0159azen\u00fdch modelek"
    },
    "allowed_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Povolen\u00e9 str\u00e1nky (pro custom opr\u00e1vn\u011bn\u00ed)"
    },
    "nickname": {
      "type": "string",
      "description": "P\u0159ezd\u00edvka u\u017eivatele zobrazovan\u00e1 v aplikaci"
    }
  },
  "required": [
    "assigned_model_ids",
    "allowed_pages"
  ]
}