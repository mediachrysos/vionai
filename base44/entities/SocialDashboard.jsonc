{
  "name": "SocialDashboard",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Dashboard name (e.g. Dashboard 1)"
    },
    "designer_email": {
      "type": "string",
      "description": "Email of assigned designer"
    },
    "designer_name": {
      "type": "string",
      "description": "Designer name for display"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "photo"
      ],
      "description": "Content type this designer handles \u2014 used to route chatter graphic requests"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Dashboard order"
    },
    "hourly_rate": {
      "type": "number",
      "default": 35,
      "description": "Hourly rate in MAD (Moroccan Dirhams)"
    },
    "auto_duplicate": {
      "type": "boolean",
      "default": false,
      "description": "Automatically duplicate tasks to next week"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}