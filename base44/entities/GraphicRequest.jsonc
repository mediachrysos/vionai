{
  "name": "GraphicRequest",
  "type": "object",
  "properties": {
    "chatter_email": {
      "type": "string"
    },
    "chatter_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "photo"
      ]
    },
    "assigned_designer_email": {
      "type": "string"
    },
    "assigned_designer_name": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done",
        "rejected"
      ],
      "default": "pending"
    },
    "request_date": {
      "type": "string",
      "format": "date",
      "description": "Datum, na kter\u00e9 chatter chce obsah dodat"
    },
    "reference_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    },
    "result_url": {
      "type": "string"
    }
  },
  "required": [
    "chatter_email",
    "title",
    "content_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "data.assigned_designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "data.assigned_designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.chatter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}