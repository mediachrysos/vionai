{
  "name": "DaySubmission",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string"
    },
    "day_key": {
      "type": "string",
      "description": "mon/tue/wed/thu/fri/sat/sun"
    },
    "day_name": {
      "type": "string"
    },
    "admin_link": {
      "type": "string"
    },
    "task_submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_idx": {
            "type": "integer"
          },
          "submitted_link": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "submitted",
              "approved",
              "rejected",
              "edit_requested"
            ]
          },
          "admin_note": {
            "type": "string"
          },
          "submitted_at": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "week_start",
    "day_key"
  ]
}