{
  "name": "Space",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the space / agency"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the space owner (admin of this space)"
    },
    "owner_name": {
      "type": "string",
      "description": "Full name of the space owner"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique invite code for team members to join this space"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active",
      "description": "Status of the space"
    },
    "member_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of members in this space"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes by super-admin"
    }
  },
  "required": [
    "name",
    "owner_email",
    "invite_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}