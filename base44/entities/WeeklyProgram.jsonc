{
  "name": "WeeklyProgram",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "description": "Monday of the week (YYYY-MM-DD)"
    },
    "designer_email": {
      "type": "string",
      "description": "Email of the designer this program belongs to"
    },
    "is_draft": {
      "type": "boolean",
      "default": false,
      "description": "True = auto-copied from previous week, pending admin confirmation"
    },
    "mon_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tue_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "wed_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "thu_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fri_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sat_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sun_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "week_start"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.designer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}