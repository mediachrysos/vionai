      "type": "number",
      "description": "Vyplacen\u00e1 \u010d\u00e1stka"
    },
    "month": {
      "type": "string",
      "description": "M\u011bs\u00edc ve form\u00e1tu YYYY-MM"
    },
    "note": {
      "type": "string",
      "description": "Pozn\u00e1mka"
    }
  },
  "required": [
    "owner",
    "amount",
    "month"
  ],
  "rls": {
